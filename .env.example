# Copy to .env and adjust. Everything has a working default for local development.

# Public name of the site (placeholder brand).
NEXT_PUBLIC_APP_NAME=Arcadia

# Where the main site runs and where games are served from. In production these MUST be
# different registered domains (e.g. arcadia.gg and arcadia-play.net).
APP_ORIGIN=http://localhost:3002
NEXT_PUBLIC_PLAY_ORIGIN=http://localhost:3001
PLAY_PORT=3001

# Database. Leave empty to use the embedded Postgres (PGlite) in .data/pglite.
# In production use a real Postgres URL (Neon, Supabase, Fly Postgres...).
DATABASE_URL=

# Where uploaded game files are stored (shared by the app and the play server).
STORAGE_DIR=.data/storage

# Business rules
FREE_DAILY_SECONDS=1800
PRO_PRICE_CENTS=599
CREATOR_POOL_SHARE=0.5

# Stripe (optional). Without these, the Pro page has a "dev mode" upgrade button.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Seed admin password (npm run db:seed). Change it!
SEED_ADMIN_PASSWORD=arcadia-admin

# Production only: seed the 6 demo games + demo users on startup (skips if already seeded).
SEED_DEMO=false
# Production only: allow the no-payment "dev mode" Pro button (for private testing without Stripe).
ALLOW_DEV_BILLING=false
