{
  "name": "arcadia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n app,play -c magenta,cyan \"next dev -p 3002\" \"node play-server/server.mjs\"",
    "dev:app": "next dev -p 3002",
    "play": "node play-server/server.mjs",
    "build": "next build",
    "start": "concurrently -k -n app,play \"next start -p ${PORT:-3002}\" \"node play-server/server.mjs\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-monaco.mjs",
    "start:prod": "npm run db:migrate && node scripts/seed-if-enabled.mjs && npm start"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.3",
    "jszip": "^3.10.2",
    "monaco-editor": "^0.52.2",
    "nanoid": "^6.0.1",
    "next": "15.5.26",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.12"
  }
}
